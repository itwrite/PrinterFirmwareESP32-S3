# IJPD 打印机固件 sdkconfig.defaults（Phase 5）
# 硬件假设：ESP32-S3 N16R8（16MB Quad Flash + 8MB Octal PSRAM）
# —— 板卡型号未确认（docs/hardware_questions.md Q1），PSRAM 类型按 N16R8 假设

CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB（分区表见 partitions.csv）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM：Octal 80MHz（N16R8 假设；若为 Quad 板卡需改 SPIRAM_MODE_QUAD）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# NimBLE：仅外设角色
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# FreeRTOS / 看门狗
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# C++：无异常 / 无 RTTI
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# 主任务栈
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 控制台走 USB-Serial/JTAG（ESP32-S3 原生 USB 口输出日志）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# WPA3（iPhone 热点默认加密方式）
CONFIG_ESP_WIFI_ENABLE_WPA3=y
CONFIG_ESP_WIFI_ENABLE_SAE=y

# Keep general Wi-Fi fast paths in IRAM, but leave Wi-Fi RX code in flash.
# This preserves the common control/tx path while recovering IRAM headroom.
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
